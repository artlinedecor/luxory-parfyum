# ── Meta (Facebook) Pixel & Conversions API ──────────────────────────────
# Pixel / Dataset ID (Events Manager → Data Sources)
NEXT_PUBLIC_META_PIXEL_ID=1576987160104483
# Conversions API access token (Events Manager → Settings → Conversions API → Generate access token)
# BUsiz server-side CAPI ISHLAMAYDI (route 400 qaytaradi). Vercel env ga qo'shilishi SHART.
META_ACCESS_TOKEN=

# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Admin panel ───────────────────────────────────────────────────────────
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Sessiya imzosi uchun (kamida 32 belgi). Yasash:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# ── Server ichki chaqiruvlari ─────────────────────────────────────────────
# click/complete -> telegram-notify chaqiruvi shu bilan himoyalanadi
INTERNAL_API_SECRET=

# ── Supabase server kaliti ────────────────────────────────────────────────
# ⚠️ NEXT_PUBLIC_ prefiksi BO'LMASIN — brauzerga chiqmasligi kerak.
# RLS yoqilgach server route'lari shusiz ishlamaydi.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram bot (buyurtma bildirishnomasi) ───────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# setWebhook da ishlatilgan maxfiy so'z bilan AYNAN bir xil bo'lishi shart:
#   node scripts/set-telegram-webhook.cjs <BOT_TOKEN>
TELEGRAM_WEBHOOK_SECRET=

# ── Yandex Metrica (ixtiyoriy) ────────────────────────────────────────────
NEXT_PUBLIC_YANDEX_METRICA_ID=

# ── Click.uz ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_CLICK_SERVICE_ID=
NEXT_PUBLIC_CLICK_MERCHANT_ID=
# ⚠️ Server tomon (NEXT_PUBLIC_ siz) — busiz OFD fiskal chek yaratilmaydi:
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=
# Fiskal chek uchun MAJBURIY (Click hujjati: CommissionInfo).
# Ikkisidan BIRI to'ldirilishi shart, aks holda Click chekni rad etadi.
CLICK_OFD_TIN=
CLICK_OFD_PINFL=

# ── Uzum Nasiya ───────────────────────────────────────────────────────────
UZUM_PARTNER_TOKEN=
NEXT_PUBLIC_UZUM_ENABLED=true
